{
  "name": "omniscient-scheduled-broadcasts",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    // 2026-10-13 : pointe desormais vers la vraie prod (le Worker n'a pas d'acces reseau au PC
    // de dev, localhost ne marchait jamais une fois deploye) — "wrangler deploy" reste un geste
    // manuel, cette valeur ne prend effet qu'au prochain deploiement reel du Worker.
    "SITE_URL": "https://omniscientlauncher.com"
  }
}
