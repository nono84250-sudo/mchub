// use prisma-8

model User {
  id   String  @id @default(uuid())
  name String
  servers Server[]

  // La connexion se fait uniquement par "Se connecter avec Microsoft" (voir
  // auth.ts) : ni email ni mot de passe ne sont stockes. minecraftUuid est la
  // seule cle vraiment stable (voir xboxAuth.ts) : garantie presente et
  // immuable pour tout compte Xbox/Minecraft relie.
  minecraftUuid     String? @unique
  minecraftUsername String?

  // Revocation des jetons de session du launcher (voir lib/launcherSession.ts) :
  // un jeton emis avant cette date est refuse. Rempli a la deconnexion du launcher.
  sessionsValidAfter TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum server_type {
  @@type("pg/text@1")
  vanilla = "vanilla"
  modded  = "modded"
}

// Fiche serveur. Deux niveaux d'info : les champs publics (annuaire du
// site) et `ip`, qui n'est jamais exposee par l'API publique - elle ne
// sera lue que par l'application (Phase 3), une fois le joueur connecte.
model Server {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String
  bannerUrl     String?
  iconUrl       String?
  backgroundUrl String?
  type          server_type @default(vanilla)

  minecraftVersion String
  ip               String

  curseforgeModpackId      String?
  curseforgeModpackName    String?
  // Jamais choisie par le proprietaire, jamais un numero fige : juste la
  // derniere version reellement resolue a l'installation (voir getModpackInstallFile/
  // getModrinthModpackInstallFile), remise a jour toute seule a chaque lancement
  // quand l'auteur du modpack en publie une nouvelle (route .../modpack).
  // Purement informatif pour l'affichage (fiche publique, Parametres).
  curseforgeModpackVersion String?

  // Plateforme d'ou vient le modpack. Les trois colonnes curseforgeModpack*
  // gardent leur nom historique mais contiennent, pour "modrinth", l'identifiant
  // du projet Modrinth, son nom et le numero de version — a renommer un jour
  // (migration de renommage, plus lourde qu'un simple ajout).
  modpackSource modpack_source @default(curseforge)

  playerCount    Int?
  playerCapacity Int?
  lastPingedAt   TimestamptzString?

  // Suggeree au lancement par le launcher : comparee a la RAM totale de la
  // machine du joueur pour choisir/avertir avant de demarrer le jeu (voir
  // cahier des charges, "avertissement de securite RAM"). Jamais imposee :
  // juste une recommandation cote proprietaire du serveur.
  recommendedRamGB Int?

  // Page de gestion (dashboard proprietaire) : mettre en pause retire le
  // serveur de l'annuaire public et empeche le launcher de le lister/le
  // lancer, sans supprimer sa configuration. viewCount/launchCount sont de
  // simples compteurs incrementes cote site (vue de la fiche publique) et
  // par le launcher (lancement reussi) - pas d'historique dans le temps.
  published   Boolean @default(true)

  // Gel par l'equipe (panel admin) : serveur retire de l'annuaire, lancement refuse par le site.
  // Vide = pas gele. Seul un admin degele (voir /api/admin/servers/[id]/unfreeze).
  frozenAt     TimestamptzString?
  frozenReason String?
  frozenBy     String?
  viewCount   Int     @default(0)
  launchCount Int     @default(0)

  // Visibilite (distincte de `published`, voir ci-dessus) : un serveur prive
  // n'apparait ni dans l'annuaire public ni dans l'API /api/public/servers
  // (voir listPublicServers) — seul le code/lien d'invitation permet de le
  // rejoindre. inviteCode genere/regenere uniquement quand isPrivate passe a
  // true (voir setServerVisibility) ; conserve tel quel si repasse public,
  // pour ne pas invalider un lien deja partage si le joueur change d'avis.
  isPrivate  Boolean @default(false)
  inviteCode String? @unique

  // Liens affiches sur la fiche publique, a cote de la description — un
  // premier pas simple pour donner plus de presence au proprietaire, en
  // attendant une vraie personnalisation de la page (voir memoire
  // project_page_builder : page 100% editable, probablement liee a
  // l'abonnement, pas construite ici).
  discordUrl String?
  websiteUrl String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  events  ServerEvent[]
  reports Report[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([ownerId])
}

enum modpack_source {
  @@type("pg/text@1")
  curseforge = "curseforge"
  modrinth   = "modrinth"
}

enum server_event_kind {
  @@type("pg/text@1")
  view   = "view"
  launch = "launch"
}

// Journal horodate des vues/lancements — sert a construire les graphiques
// de la page "Activite" (jour/semaine/mois/annee), en plus des compteurs
// simples viewCount/launchCount sur Server (qui restent pour l'affichage
// rapide en Vue d'ensemble). Pas de suivi du nombre de joueurs en ligne
// dans le temps ici : ca demanderait un ping periodique en tache de fond,
// qui n'existe pas dans ce projet (le ping actuel n'a lieu qu'a la lecture
// d'une page) — voir la page Activite pour la note affichee a ce sujet.
model ServerEvent {
  id       String            @id @default(uuid())
  serverId String
  server   Server            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  kind     server_event_kind

  createdAt TimestamptzString @default(now())

  @@index([serverId, kind, createdAt])
}

enum report_issue {
  @@type("pg/text@1")
  cant_connect     = "cant_connect"
  wrong_version    = "wrong_version"
  modpack_download = "modpack_download"
  crash            = "crash"
  other            = "other"
}

enum report_status {
  @@type("pg/text@1")
  new      = "new"
  replied  = "replied"
  resolved = "resolved"
}

// Signalement technique envoye par un joueur depuis le launcher (voir "03b
// Report a server" dans Design/Omniscient Launcher UI Mockups.dc.html) —
// uniquement la categorie "Probleme technique" (va au proprietaire). La
// categorie "Comportement/contenu" de la maquette (va aux moderateurs
// Omniscient) n'a nulle part ou atterrir tant que le panel admin/moderation
// n'existe pas (voir memoire project_platform_admin_panel) : volontairement
// pas implementee, pour ne pas construire un bouton qui ne mene nulle part.
model Report {
  id       String @id @default(uuid())
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  // Identite du joueur qui signale — jamais un compte Omniscient (le
  // launcher connait deja son profil Minecraft/Xbox, voir xboxAuth.ts), donc
  // pas de relation vers User ici : juste de quoi identifier le joueur pour
  // le proprietaire.
  reporterMinecraftUuid     String
  reporterMinecraftUsername String

  issue   report_issue
  message String

  // Diagnostics optionnels (case a cocher cote launcher) : versions au
  // moment du signalement. La version serveur n'est pas dupliquee ici — elle
  // est comparee a Server.minecraftVersion (valeur actuelle) au moment de
  // l'affichage, pour refleter un ecart reellement toujours d'actualite.
  clientVersion   String?
  launcherVersion String?

  status report_status @default(new)
  reply  String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([serverId, status, createdAt])
}

enum notification_type {
  @@type("pg/text@1")
  report_replied  = "report_replied"
  report_resolved = "report_resolved"
  server_frozen   = "server_frozen"
  admin_info      = "admin_info"
  admin_warning   = "admin_warning"
  admin_error     = "admin_error"
}

// Alerte personnelle pour un joueur (cloche du launcher, voir memoire
// project_notifications_system) — distincte des Actualites (diffusion admin
// identique pour tout le monde). Cible par minecraftUuid et non par une
// relation User : comme pour Report, le joueur qui a signale un probleme n'a
// pas forcement de compte Omniscient (il n'a jamais utilise que le launcher).
// serverName est duplique volontairement (pas de relation Server) pour rester
// affichable meme si le serveur est supprime plus tard.
model Notification {
  id                     String             @id @default(uuid())
  recipientMinecraftUuid String
  type                   notification_type
  serverName             String
  message                String?
  read                   Boolean            @default(false)
  createdAt              TimestamptzString  @default(now())

  @@index([recipientMinecraftUuid, read, createdAt])
}

// Reglages globaux de la plateforme, modifiables par un admin (panel admin,
// section "Sources de modpacks"). Ex. cle "source.curseforge" = "off". Une
// valeur absente vaut la valeur par defaut du code (voir lib/platformSettings.ts).
model PlatformSetting {
  key       String            @id
  value     String
  updatedAt TimestamptzString @default(now())
}

// Comptes de l'administration de la plateforme (panel /admin), separes des comptes
// Microsoft des joueurs. Mot de passe jamais en clair (scrypt, voir lib/adminAuth.ts).
// mustChangeCredentials : vrai a la creation, la personne doit changer son nom
// d'utilisateur et son mot de passe avant toute autre action.
model AdminAccount {
  id                    String            @id @default(uuid())
  username              String            @unique
  passwordHash          String
  role                  String
  mustChangeCredentials Boolean           @default(true)
  createdAt             TimestamptzString @default(now())
}
