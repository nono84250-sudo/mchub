// use prisma-8

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  name         String
  servers      Server[]

  // Lie ce compte site a un profil Minecraft/Xbox (uuid + pseudo), pour que
  // le launcher (deja connecte via son propre flux Microsoft, voir
  // launcher/src/msAuth.js) puisse retrouver "Mes instances" sans jamais
  // avoir besoin du mot de passe du site — voir le flux de code de liaison
  // dans /account et POST /api/launcher/link-minecraft.
  minecraftUuid     String? @unique
  minecraftUsername String?
  linkCodes         MinecraftLinkCode[]

  // Defaut a true (et non false) pour que les comptes deja crees avant
  // l'ajout de ce champ restent utilisables sans reverification forcee —
  // seule la creation de compte (signup()) force explicitement false, avant
  // la saisie du code recu par email.
  emailVerified Boolean     @default(true)
  authTokens    AuthToken[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum auth_token_kind {
  @@type("pg/text@1")
  email_verify   = "email_verify"
  password_reset = "password_reset"
}

// Codes/jetons ephemeres envoyes par email : "email_verify" (code a 6
// caracteres, inscription) et "password_reset" (code a 6 caracteres pour
// "mot de passe oublie" OU jeton long integre dans le lien envoye depuis
// /account — meme table, seule la longueur du token differe). Usage unique,
// courte duree de vie — meme principe que MinecraftLinkCode.
model AuthToken {
  id     String           @id @default(uuid())
  token  String           @unique
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   auth_token_kind

  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())

  @@index([userId, kind])
}

// Code de liaison ephemere (6 caracteres, usage unique) : genere depuis
// /account, saisi dans le launcher qui connait deja l'UUID Minecraft du
// joueur via sa propre auth Microsoft (voir launcher/src/msAuth.js) — evite
// de jamais faire transiter le mot de passe du site dans l'app Electron.
// Supprime des sa consommation ; les codes expires et non utilises restent
// jusqu'a nettoyage (volume negligeable, pas de tache de fond dediee).
model MinecraftLinkCode {
  id     String @id @default(uuid())
  code   String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())

  @@index([userId])
}

enum server_type {
  @@type("pg/text@1")
  vanilla = "vanilla"
  modded  = "modded"
}

// Fiche serveur. Deux niveaux d'info : les champs publics (annuaire du
// site) et `ip`, qui n'est jamais exposee par l'API publique - elle ne
// sera lue que par l'application (Phase 3), une fois le joueur connecte.
model Server {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String
  bannerUrl   String?
  iconUrl     String?
  type        server_type @default(vanilla)

  minecraftVersion String
  ip               String

  curseforgeModpackId      String?
  curseforgeModpackName    String?
  curseforgeModpackVersion String?

  playerCount    Int?
  playerCapacity Int?
  lastPingedAt   TimestamptzString?

  // Suggeree au lancement par le launcher : comparee a la RAM totale de la
  // machine du joueur pour choisir/avertir avant de demarrer le jeu (voir
  // cahier des charges, "avertissement de securite RAM"). Jamais imposee :
  // juste une recommandation cote proprietaire du serveur.
  recommendedRamGB Int?

  // Page de gestion (dashboard proprietaire) : mettre en pause retire le
  // serveur de l'annuaire public et empeche le launcher de le lister/le
  // lancer, sans supprimer sa configuration. viewCount/launchCount sont de
  // simples compteurs incrementes cote site (vue de la fiche publique) et
  // par le launcher (lancement reussi) - pas d'historique dans le temps.
  published   Boolean @default(true)
  viewCount   Int     @default(0)
  launchCount Int     @default(0)

  // Liens affiches sur la fiche publique, a cote de la description — un
  // premier pas simple pour donner plus de presence au proprietaire, en
  // attendant une vraie personnalisation de la page (voir memoire
  // project_page_builder : page 100% editable, probablement liee a
  // l'abonnement, pas construite ici).
  discordUrl String?
  websiteUrl String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  events ServerEvent[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([ownerId])
}

enum server_event_kind {
  @@type("pg/text@1")
  view   = "view"
  launch = "launch"
}

// Journal horodate des vues/lancements — sert a construire les graphiques
// de la page "Activite" (jour/semaine/mois/annee), en plus des compteurs
// simples viewCount/launchCount sur Server (qui restent pour l'affichage
// rapide en Vue d'ensemble). Pas de suivi du nombre de joueurs en ligne
// dans le temps ici : ca demanderait un ping periodique en tache de fond,
// qui n'existe pas dans ce projet (le ping actuel n'a lieu qu'a la lecture
// d'une page) — voir la page Activite pour la note affichee a ce sujet.
model ServerEvent {
  id       String            @id @default(uuid())
  serverId String
  server   Server            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  kind     server_event_kind

  createdAt TimestamptzString @default(now())

  @@index([serverId, kind, createdAt])
}
