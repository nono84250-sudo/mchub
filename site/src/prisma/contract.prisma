// use prisma-8

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  name         String
  servers      Server[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum server_type {
  @@type("pg/text@1")
  vanilla = "vanilla"
  modded  = "modded"
}

// Fiche serveur. Deux niveaux d'info : les champs publics (annuaire du
// site) et `ip`, qui n'est jamais exposee par l'API publique - elle ne
// sera lue que par l'application (Phase 3), une fois le joueur connecte.
model Server {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String
  bannerUrl   String?
  type        server_type @default(vanilla)

  minecraftVersion String
  ip               String

  curseforgeModpackId      String?
  curseforgeModpackName    String?
  curseforgeModpackVersion String?

  playerCount    Int?
  playerCapacity Int?
  lastPingedAt   TimestamptzString?

  // Suggeree au lancement par le launcher : comparee a la RAM totale de la
  // machine du joueur pour choisir/avertir avant de demarrer le jeu (voir
  // cahier des charges, "avertissement de securite RAM"). Jamais imposee :
  // juste une recommandation cote proprietaire du serveur.
  recommendedRamGB Int?

  // Page de gestion (dashboard proprietaire) : mettre en pause retire le
  // serveur de l'annuaire public et empeche le launcher de le lister/le
  // lancer, sans supprimer sa configuration. viewCount/launchCount sont de
  // simples compteurs incrementes cote site (vue de la fiche publique) et
  // par le launcher (lancement reussi) - pas d'historique dans le temps.
  published   Boolean @default(true)
  viewCount   Int     @default(0)
  launchCount Int     @default(0)

  // Liens affiches sur la fiche publique, a cote de la description — un
  // premier pas simple pour donner plus de presence au proprietaire, en
  // attendant une vraie personnalisation de la page (voir memoire
  // project_page_builder : page 100% editable, probablement liee a
  // l'abonnement, pas construite ici).
  discordUrl String?
  websiteUrl String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([ownerId])
}
