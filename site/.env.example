# Modele des variables d env du site. Copier en site/.env (fichier non commite)
# et remplir. Ne jamais mettre de vraie valeur dans ce fichier.
LAUNCHER_API_KEY=
# Secret de signature des jetons de session du launcher (24 h). Au moins 32 caracteres.
# Generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
LAUNCHER_SESSION_SECRET=
