{
  "name": "launcher",
  "productName": "Omniscient Launcher",
  "version": "0.4.0-beta.5",
  "private": true,
  "description": "Launcher Minecraft Omniscient — lit les serveurs publiés sur le site Omniscient et lance le jeu.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "predist": "node scripts/generate-env.js",
    "dist": "electron-builder",
    "predist:linux": "node scripts/generate-env.js",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@sentry/electron": "7.20.0",
    "@xhayper/discord-rpc": "^1.3.4",
    "adm-zip": "^0.6.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2"
  },
  "build": {
    "appId": "app.omniscient.launcher",
    "productName": "Omniscient Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Omniscient Launcher",
        "schemes": ["omniscient"]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "nono84250-sudo",
      "repo": "omniscient-launcher"
    },
    "win": {
      "target": "nsis-web",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Game",
      "artifactName": "OmniscientLauncher-${version}.${ext}"
    },
    "nsisWeb": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OmniscientLauncherSetup.${ext}"
    }
  }
}
