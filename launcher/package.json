{
  "name": "launcher",
  "productName": "Omniscient Launcher",
  "version": "0.1.11",
  "private": true,
  "description": "Launcher Minecraft Omniscient — lit les serveurs publiés sur le site Omniscient et lance le jeu.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "predist": "node scripts/generate-env.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2"
  },
  "build": {
    "appId": "app.omniscient.launcher",
    "productName": "Omniscient Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "nono84250-sudo",
      "repo": "omniscient-launcher"
    },
    "win": {
      "target": "nsis-web",
      "icon": "build/icon.ico"
    },
    "nsisWeb": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OmniscientLauncherSetup.${ext}"
    }
  }
}
